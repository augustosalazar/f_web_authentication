EXPO_PUBLIC_ROBLE_PROJECT_ID=#your_project_id_here
BASE_URL=roble-api.test-openlab.uninorte.edu.co
ROBLE_SSO_REDIRECT=f_web_authentication
ROBLE_SSO_REDIRECT_MOBILE=f-web-authentication-movil

# Google nativo (movil). El Client ID **web** no va aqui: lo trae Roble en
# /auth/providers, asi que Google se configura solo en la consola.
#
# Esto es lo unico que queda en la app, porque es por plataforma y Roble no lo
# guarda. Solo iOS; en Android se deja vacio y lo resuelve el SDK con la firma
# del APK.
GOOGLE_IOS_CLIENT_ID=#your_ios_client_id.apps.googleusercontent.com
